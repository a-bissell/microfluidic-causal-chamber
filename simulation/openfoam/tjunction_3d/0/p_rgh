FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    oil_inlet
    {
        // Floats to match the fixed-velocity inlet in 0/U; for
        // pressure-driven runs use totalPressure with p0 ~ 850 Pa.
        type            fixedFluxPressure;
        value           uniform 0;
    }

    water_inlet
    {
        // For pressure-driven runs: totalPressure, p0 ~ 650 Pa.
        type            fixedFluxPressure;
        value           uniform 0;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    walls
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}

