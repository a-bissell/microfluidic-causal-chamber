FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    oil_inlet
    {
        // Fixed-velocity inlet: Ca = mu_oil*U/sigma = 0.032 (droplet regime).
        // See tjunction_2d/0/U for why the original 50/30 kPa pressure
        // inlets produced no droplets (Ca ~ 1.9, stalled water inlet).
        type            fixedValue;
        value           uniform (0.02 0 0);
    }

    water_inlet
    {
        // Q_disp/Q_cont = 0.25
        type            fixedValue;
        value           uniform (0 -0.01 0);
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    walls
    {
        type            noSlip;
    }
}

