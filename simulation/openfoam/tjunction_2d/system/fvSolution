FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Linear solver settings for interFoam
// Configured for microfluidic two-phase flow

solvers
{
    // Volume fraction (alpha) - use smoothSolver with symGaussSeidel
    "alpha.water.*"
    {
        // MULES (Multidimensional Universal Limiter with Explicit Solution)
        // Specialized for VOF interface tracking
        nAlphaCorr      2;          // Sub-cycles for alpha equation
        nAlphaSubCycles 1;          // Sub-iterations per time step
        
        // Compression settings
        MULESCorr       yes;
        nLimiterIter    5;
        cAlpha          1;      // interface compression (required by ESI interFoam)
        
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }
    
    // Corrector for alpha
    "pcorr.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    }
    
    // Pressure (p_rgh)
    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-7;
        relTol          0.01;
    }
    
    // Final pressure solve (tighter tolerance)
    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }
    
    // Velocity
    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }
}

// PIMPLE algorithm settings (Pressure-Implicit with splitting of operators)
PIMPLE
{
    // Number of PIMPLE outer loops
    nOuterCorrectors    1;
    
    // Number of pressure corrections
    nCorrectors         3;
    
    // Number of non-orthogonal corrections
    nNonOrthogonalCorrectors 1;
    
    // Use momentum predictor
    momentumPredictor   no;
}

// Relaxation factors (for steady-state runs, not typically needed for transient)
relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}

