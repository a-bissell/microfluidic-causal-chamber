FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    oil_inlet
    {
        // Fixed-velocity inlet. U = 20 mm/s gives Ca = mu_oil*U/sigma = 0.032,
        // in the squeezing/dripping transition where droplets form.
        // The original pressure-driven BCs (totalPressure 50/30 kPa) produced
        // Ca ~ 1.9 and a junction pressure above the water inlet pressure, so
        // no droplets could form (stratified flow, zero sustained water flux).
        type            fixedValue;
        value           uniform (0.02 0 0);
    }

    water_inlet
    {
        // Q_disp/Q_cont = (0.01*75um)/(0.02*150um) = 0.25
        // Expected slug length (Garstecki): L/w = 1 + alpha*0.25
        type            fixedValue;
        value           uniform (0 -0.01 0);
    }

    outlet
    {
        // Allow flow to exit naturally
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    walls
    {
        // No-slip condition at solid walls
        type            noSlip;
    }

    frontAndBack
    {
        // 2D simulation - empty boundary
        type            empty;
    }
}

