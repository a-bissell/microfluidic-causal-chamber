FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// p_rgh = p - rho*g*h (pressure minus hydrostatic component)
// For microfluidic scales, hydrostatic pressure is negligible
// so p_rgh ≈ p

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    oil_inlet
    {
        // Pressure floats to match the fixed-velocity inlet in 0/U.
        // For a pressure-driven run (the causal-chamber actuation mode), use
        // totalPressure with p0 ~ 850 Pa here and ~650 Pa at water_inlet:
        // at these channel lengths 50 kPa drives ~1.2 m/s (Ca ~ 1.9, no
        // droplets), and 30 kPa at the water inlet is below the ~33 kPa
        // junction pressure, so water cannot flow in at all.
        type            fixedFluxPressure;
        value           uniform 0;
    }

    water_inlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    outlet
    {
        // Atmospheric pressure (gauge = 0)
        type            fixedValue;
        value           uniform 0;
    }

    walls
    {
        // Zero-flux for pressure at walls
        type            fixedFluxPressure;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

