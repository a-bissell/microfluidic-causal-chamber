FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleVoF;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// Pressure-driven startup + ~2 droplet periods at the reference point.
endTime         0.06;

deltaT          1e-7;

writeControl    adjustableRunTime;

writeInterval   0.002;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;

maxAlphaCo      0.5;

// Capillary timestep limit sqrt(rho*dx^3/(2*pi*sigma)) ~ 8e-7 s at dx = 5 um.
// interFoam does not enforce it; at the new low velocities the Courant limit
// alone would allow dt ~ 1e-4 and parasitic currents would destroy the
// interface, so cap dt just below the capillary limit.
maxDeltaT       1.3e-6;   // capillary limit ~1.5e-6 s at the 7.5 um cells

// No function objects for now - simpler run
functions
{
}

