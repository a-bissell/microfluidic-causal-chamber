FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    oil_inlet
    {
        // Pressure floats to match the fixed-velocity inlets in 0/U.
        type            fixedFluxPressure;
        value           uniform 0;
    }

    water_inlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    symmetryPlane
    {
        type            symmetry;
    }

    walls
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}

